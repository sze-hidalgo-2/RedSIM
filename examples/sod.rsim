#mesh
file        :: "cube_4M.su2"

#solver
model       :: "navier-stokes"
integrator  :: "ssprk-4-3"
limiter     :: "barth-jespersen"

#simulaion
time        :: 0.2

#boundary
"x-min"     ::  "slip"
"y-min"     ::  "slip"
"z-min"     ::  "slip"
"x-max"     ::  "slip"
"y-max"     ::  "slip"
"z-max"     ::  "slip"

